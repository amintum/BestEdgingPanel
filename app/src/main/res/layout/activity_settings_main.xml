<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/settings_title"
            app:titleCentered="true" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/settingsMainContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp">

                <!-- Master Service Switch Hero Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMasterSwitch"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="@dimen/m3_expressive_hero_corner"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardMasterSwitchIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:id="@+id/ivMasterSwitchIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_tile_sidebar"
                                app:tint="?attr/colorPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMasterSwitchTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/use_edge_panel"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMasterSwitchSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/status_service_active"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchMasterService"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Full-Width Floating Search Pill -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:clipChildren="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/searchCard"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        app:cardCornerRadius="26dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:contentPadding="0dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:id="@+id/searchContainer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="18dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivSearchIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_menu_search"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tvSearchHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/search_settings_hint"
                                android:includeFontPadding="false"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="15sp" />

                            <EditText
                                android:id="@+id/etSettingsSearch"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="@string/search_settings_hint"
                                android:imeOptions="actionSearch"
                                android:inputType="text"
                                android:maxLines="1"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:includeFontPadding="false"
                                android:gravity="center_vertical"
                                android:textColor="?attr/colorOnSurface"
                                android:textColorHint="?attr/colorOnSurfaceVariant"
                                android:textSize="15sp"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/btnClearSearch"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:padding="5dp"
                                android:src="@drawable/ic_clear"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:visibility="gone"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSettingsResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:paddingTop="8dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />

                <!-- Empty State Layout -->
                <LinearLayout
                    android:id="@+id/layoutSearchEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="48dp"
                    android:paddingHorizontal="24dp"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/search_no_results"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/search_no_results_desc"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Android 16 Inset Grouped Settings Pods -->
                <LinearLayout
                    android:id="@+id/settingsCategoriesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Section Header 1: PERSONALIZATION -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/category_personalization"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Pod 1: Look & Feel -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/SidePanel.ExpressivePod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:contentPadding="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Appearance Row -->
                            <LinearLayout
                                android:id="@+id/btnAppearance"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="@dimen/m3_expressive_badge_size"
                                    android:layout_height="@dimen/m3_expressive_badge_size"
                                    app:cardCornerRadius="@dimen/m3_expressive_badge_corner"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_section_appearance"
                                        app:tint="?attr/colorOnSecondaryContainer" />
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/section_appearance"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/main_menu_appearance_desc"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <!-- Hairline Indented Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="@dimen/m3_expressive_divider_indent"
                                android:background="?attr/colorOutlineVariant"
                                android:alpha="0.25" />

                            <!-- Handle & Pill Row -->
                            <LinearLayout
                                android:id="@+id/btnHandle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="@dimen/m3_expressive_badge_size"
                                    android:layout_height="@dimen/m3_expressive_badge_size"
                                    app:cardCornerRadius="@dimen/m3_expressive_badge_corner"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_section_handle"
                                        app:tint="?attr/colorOnSecondaryContainer" />
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/section_handle"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/main_menu_handle_desc"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Section Header 2: CONTROLS & GESTURES -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/category_controls"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Pod 2: Controls & Tools -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/SidePanel.ExpressivePod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:contentPadding="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Interaction Row -->
                            <LinearLayout
                                android:id="@+id/btnInteraction"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="@dimen/m3_expressive_badge_size"
                                    android:layout_height="@dimen/m3_expressive_badge_size"
                                    app:cardCornerRadius="@dimen/m3_expressive_badge_corner"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_section_interaction"
                                        app:tint="?attr/colorOnSecondaryContainer" />
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/section_interaction"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/main_menu_interaction_desc"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <!-- Hairline Indented Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="@dimen/m3_expressive_divider_indent"
                                android:background="?attr/colorOutlineVariant"
                                android:alpha="0.25" />

                            <!-- Dashboard Tools Row -->
                            <LinearLayout
                                android:id="@+id/btnTools"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="@dimen/m3_expressive_badge_size"
                                    android:layout_height="@dimen/m3_expressive_badge_size"
                                    app:cardCornerRadius="@dimen/m3_expressive_badge_corner"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_section_tools"
                                        app:tint="?attr/colorOnSecondaryContainer" />
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/section_tools"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/main_menu_tools_desc"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Section Header 3: SYSTEM -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/category_system"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Pod 3: System & Miscellaneous -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/SidePanel.ExpressivePod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:contentPadding="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Miscellaneous Row -->
                            <LinearLayout
                                android:id="@+id/btnMisc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="@dimen/m3_expressive_badge_size"
                                    android:layout_height="@dimen/m3_expressive_badge_size"
                                    app:cardCornerRadius="@dimen/m3_expressive_badge_corner"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_settings_advanced"
                                        app:tint="?attr/colorOnSecondaryContainer" />
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/section_misc"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/main_menu_misc_desc"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="13sp" />
                                </LinearLayout>

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Reset Defaults Action -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReset"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="24dp"
                        android:text="@string/settings_reset_defaults"
                        android:textColor="?attr/colorError" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
